@page
@model LogoutModel
@{
    ViewData["Title"] = "Logout";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-5">
            <div class="ff-glass p-4 p-md-5 text-center">
                <h2 class="mb-2">Logout</h2>
                <p class="text-muted mb-4">
                    Are you sure you want to sign out?
                </p>

                <form method="post">
                    <button type="submit" class="btn btn-danger btn-lg w-100 mb-2">
                        Yes, logout
                    </button>
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary w-100">
                        Cancel
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>
