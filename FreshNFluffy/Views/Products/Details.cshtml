@model FreshNFluffy.ViewModels.Products.ProductDetailsViewModel

@{
    ViewData["Title"] = "Product Details";
}

<div class="ff-glass p-4">
    <div class="row g-4">
        <div class="col-md-5">
            <img src="@(string.IsNullOrWhiteSpace(Model.ImageUrl) ? Url.Content("~/img/product-placeholder.jpg") : Model.ImageUrl)"
                 class="img-fluid rounded"
                 alt="@Model.Name"
                 onerror="this.onerror=null;this.src='@Url.Content("~/img/product-placeholder.jpg")';" />
        </div>

        <div class="col-md-7">
            <h2 class="mb-1">@Model.Name</h2>
            <p class="text-muted mb-2">@Model.CategoryName</p>

            <p class="mb-2"><strong>@Model.Price.ToString("0.00")</strong> EUR</p>
            <p class="mb-2"><strong>Nutrition:</strong> @Model.NutritionText</p>

            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="mb-3">@Model.Description</p>
            }

            <a asp-controller="Products" asp-action="Index" class="btn btn-primary">Back</a>
        </div>
    </div>
</div>
