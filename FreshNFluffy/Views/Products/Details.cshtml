@model FreshNFluffy.ViewModels.Products.ProductDetailsViewModel

@{
    ViewData["Title"] = "Product Details";
}

<div class="row">
    <div class="col-md-5">
        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" class="img-fluid rounded" alt="@Model.Name" />
        }
        else
        {
            <div class="border rounded p-5 text-center text-muted">No image</div>
        }
    </div>

    <div class="col-md-7">
        <h2>@Model.Name</h2>
        <p class="text-muted">@Model.CategoryName</p>

        <p><strong>@Model.Price.ToString("0.00")</strong> EUR</p>

        <p><strong>Nutrition:</strong> @Model.NutritionText</p>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p>@Model.Description</p>
        }

        <a asp-controller="Products" asp-action="Index" class="btn btn-secondary">Back</a>
    </div>
</div>
