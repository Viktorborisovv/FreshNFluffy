@model FreshNFluffy.ViewModels.Products.ProductDetailsViewModel

@{
	ViewData["Title"] = "Product Details";
}

<div class="ff-glass p-4">
	<div class="row g-4 align-items-start">
		<div class="col-lg-5">
			<img src="@(string.IsNullOrWhiteSpace(Model.ImageUrl) ? Url.Content("~/img/product-placeholder.jpg") : Model.ImageUrl)"
				 class="img-fluid rounded-4"
				 alt="@Model.Name"
				 onerror="this.onerror=null;this.src='@Url.Content("~/img/product-placeholder.jpg")';" />
		</div>

		<div class="col-lg-7">
			<h2 class="mb-1 fw-bold">@Model.Name</h2>
			<div class="text-muted mb-3">@Model.CategoryName</div>

			<div class="d-flex flex-wrap gap-2 mb-3">
				<span class="badge bg-success">@Model.Price.ToString("0.00") EUR</span>
				<span class="badge bg-warning">@Model.NutritionText</span>
			</div>

			@if (!string.IsNullOrWhiteSpace(Model.Description))
			{
				<p class="mb-4">@Model.Description</p>
			}

			<a asp-controller="Products" asp-action="Index" class="btn btn-primary">
				Back
			</a>
		</div>
	</div>
	<div class="ff-glass p-4 mt-4">
		<h3 class="mb-3">Reviews</h3>

		@if (User.Identity?.IsAuthenticated == true)
		{
			<form asp-controller="Reviews" asp-action="Create" method="post" class="mb-4">
				@Html.AntiForgeryToken()
				<input type="hidden" asp-for="NewReview.ProductId" />

				<div class="row g-3">
					<div class="col-md-3">
						<label asp-for="NewReview.Rating" class="form-label">Rating</label>
						<select asp-for="NewReview.Rating" class="form-select">
							<option value="">Select rating</option>
							<option value="1">1 Star</option>
							<option value="2">2 Stars</option>
							<option value="3">3 Stars</option>
							<option value="4">4 Stars</option>
							<option value="5">5 Stars</option>
						</select>
						<span asp-validation-for="NewReview.Rating" class="text-danger"></span>
					</div>

					<div class="col-md-9">
						<label asp-for="NewReview.Comment" class="form-label">Comment</label>
						<textarea asp-for="NewReview.Comment"
								  class="form-control"
								  rows="3"
								  placeholder="Share your opinion about this product..."></textarea>
						<span asp-validation-for="NewReview.Comment" class="text-danger"></span>
					</div>

					<div class="col-12">
						<button type="submit" class="btn btn-success">Add Review</button>
					</div>
				</div>
			</form>
		}
		else
		{
			<div class="alert alert-info">
				Please log in to leave a review.
			</div>
		}

		@if (!Model.Reviews.Any())
		{
			<div class="alert alert-secondary mb-0">
				No reviews yet. Be the first to review this product.
			</div>
		}
		else
		{
			<div class="d-flex flex-column gap-3">
				@foreach (var review in Model.Reviews)
				{
					<div class="p-3 rounded-3 bg-white bg-opacity-50">
						<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
							<strong>@review.UserName</strong>
							<small class="text-muted">@review.CreatedOn.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small>
						</div>

						<div class="mb-2">
							@for (int i = 1; i <= 5; i++)
							{
								if (i <= review.Rating)
								{
									<span>⭐</span>
								}
								else
								{
									<span>☆</span>
								}
							}
						</div>

						<div>@review.Comment</div>
					</div>
				}
			</div>
		}
	</div>

	@section Scripts {
		<partial name="_ValidationScriptsPartial" />
	}
</div>


