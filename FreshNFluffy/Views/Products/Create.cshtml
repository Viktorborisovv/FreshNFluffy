@model FreshNFluffy.ViewModels.Products.ProductFormViewModel

@{
    ViewData["Title"] = "Create Product";
}

<div class="ff-glass p-4">
    <h2 class="mb-3">Create Product</h2>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <partial name="_ProductFormPartial" model="Model" />

        <button type="submit" class="btn btn-success">Create</button>
        <a asp-action="Index" class="btn btn-danger ms-1">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
