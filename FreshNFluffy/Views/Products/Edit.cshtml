@model FreshNFluffy.ViewModels.Products.ProductFormViewModel

@{
    ViewData["Title"] = "Edit Product";
}

<div class="ff-glass p-4">
    <h2 class="mb-3">Edit Product</h2>

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ProductId" />

        <partial name="_ProductFormPartial" model="Model" />

        <button type="submit" class="btn btn-success">Save</button>
        <a asp-action="Details" asp-route-id="@Model.ProductId" class="btn btn-danger ms-1">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
