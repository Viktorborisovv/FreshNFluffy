@model FreshNFluffy.ViewModels.Products.ProductQueryViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@using FreshNFluffy.ViewModels.Categories

@{
	ViewData["Title"] = "Products";
}

<div class="ff-glass p-4 mb-4">
	<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
		<h2 class="mb-0">Products</h2>

		@if (User.Identity?.IsAuthenticated == true && User.IsInRole("Administrator"))
		{
			<a asp-action="Create" class="btn btn-success">
				Create Product
			</a>
		}
	</div>

	<form method="get" class="row g-2 mb-0">
		<input type="hidden" name="CurrentPage" value="1" />

		<div class="col-md-4">
			<input class="form-control" asp-for="Search" placeholder="Search by name or description..." />
		</div>

		<div class="col-md-3">
			<select class="form-select" asp-for="CategoryId"
					asp-items="@(new SelectList(Model.Categories, nameof(CategorySelectViewModel.CategoryId), nameof(CategorySelectViewModel.Name)))">
				<option value="">All categories</option>
			</select>
		</div>

		<div class="col-md-3">
			<select class="form-select" asp-for="NutritionTypes">
				<option value="">All nutrition</option>
				<option value="1">Gluten Free</option>
				<option value="2">Sugar Free</option>
				<option value="4">Lactose Free</option>
				<option value="8">Vegan</option>
				<option value="16">Keto</option>

				<option value="3">Gluten + Sugar Free</option>
				<option value="12">Lactose Free + Vegan</option>
				<option value="19">Gluten + Sugar Free + Keto</option>
			</select>
		</div>

		<div class="col-md-2">
			<button class="btn btn-info w-100 text-white" type="submit">Filter</button>
		</div>
	</form>
</div>

@if (!Model.Products.Any())
{
	<div class="alert alert-info">No products found.</div>
}
else
{
	<div class="row row-cols-1 row-cols-md-3 g-3">
		@foreach (var p in Model.Products)
		{
			<div class="col">
				<div class="card h-100 product-card">
					<img src="@(string.IsNullOrWhiteSpace(p.ImageUrl) ? Url.Content("~/img/product-placeholder.jpg") : p.ImageUrl)"
						 class="card-img-top"
						 alt="@p.Name"
						 onerror="this.onerror=null;this.src='@Url.Content("~/img/product-placeholder.jpg")';" />

					<div class="card-body">
						<h5 class="card-title">@p.Name</h5>
						<p class="card-text mb-1"><strong>@p.Price.ToString("0.00")</strong> EUR</p>
						<p class="card-text text-muted mb-2">@p.CategoryName</p>

						<div class="product-actions">
							<a asp-controller="Products" asp-action="Details" asp-route-id="@p.ProductId"
							   class="btn btn-primary btn-sm">
								Details
							</a>
							@if (User.Identity?.IsAuthenticated == true && User.IsInRole("Administrator"))
							{
								<a asp-action="Edit" asp-route-id="@p.ProductId"
								   class="btn btn-info btn-sm text-white">
									Edit
								</a>

								<a asp-action="Delete" asp-route-id="@p.ProductId"
								   class="btn btn-danger btn-sm">
									Delete
								</a>
							}
						</div>
					</div>
				</div>
			</div>
		}
	</div>

	int totalPages = (int)Math.Ceiling((double)Model.TotalProducts / Model.ProductsPerPage);

	@if (totalPages > 1)
	{
		<nav class="mt-4">
			<ul class="pagination justify-content-center">

				<li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
					<a class="page-link"
					   asp-action="Index"
					   asp-route-currentPage="@(Model.CurrentPage - 1)"
					   asp-route-search="@Model.Search"
					   asp-route-categoryId="@Model.CategoryId"
					   asp-route-nutritionTypes="@Model.NutritionTypes">
						Previous
					</a>
				</li>

				@for (int i = 1; i <= totalPages; i++)
				{
					<li class="page-item @(i == Model.CurrentPage ? "active" : "")">
						<a class="page-link"
						   asp-action="Index"
						   asp-route-currentPage="@i"
						   asp-route-search="@Model.Search"
						   asp-route-categoryId="@Model.CategoryId"
						   asp-route-nutritionTypes="@Model.NutritionTypes">
							@i
						</a>
					</li>
				}

				<li class="page-item @(Model.CurrentPage == totalPages ? "disabled" : "")">
					<a class="page-link"
					   asp-action="Index"
					   asp-route-currentPage="@(Model.CurrentPage + 1)"
					   asp-route-search="@Model.Search"
					   asp-route-categoryId="@Model.CategoryId"
					   asp-route-nutritionTypes="@Model.NutritionTypes">
						Next
					</a>
				</li>
			</ul>
		</nav>
	}
}

