@model FreshNFluffy.ViewModels.Orders.Management.OrderDetailsViewModel

@{
    ViewData["Title"] = $"Order #{Model.OrderRequestId}";
}

<h2 class="mb-3">Order #@Model.OrderRequestId</h2>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card">
            <div class="card-body">
                <p class="mb-1"><strong>Customer:</strong> @Model.CustomerName</p>
                <p class="mb-1"><strong>Phone:</strong> @Model.PhoneNumber</p>
                <p class="mb-1"><strong>Created:</strong> @Model.CreatedOn.ToString("dd.MM.yyyy HH:mm")</p>
                <p class="mb-2"><strong>Pickup:</strong> @Model.PickupDate.ToString("dd.MM.yyyy HH:mm")</p>

                <p class="mb-2">
                    <strong>Status:</strong>
                    @if (Model.StatusValue == 0)
                    {
                        <span class="badge bg-secondary">@Model.Status</span>
                    }
                    else if (Model.StatusValue == 1)
                    {
                        <span class="badge bg-success">@Model.Status</span>
                    }
                    else if (Model.StatusValue == 2)
                    {
                        <span class="badge bg-warning text-dark">@Model.Status</span>
                    }
                    else if (Model.StatusValue == 3)
                    {
                        <span class="badge bg-primary">@Model.Status</span>
                    }
                    else if (Model.StatusValue == 4)
                    {
                        <span class="badge bg-danger">@Model.Status</span>
                    }
                    else
                    {
                        <span class="badge bg-dark">@Model.Status</span>
                    }
                </p>

                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div class="mt-2">
                        <strong>Notes:</strong>
                        <div class="text-muted">@Model.Notes</div>
                    </div>
                }

                <div class="mt-3">
                    <a asp-action="Manage" class="btn btn-secondary">Back to Manage</a>

                    <a asp-action="AddItems"
                       asp-route-id="@Model.OrderRequestId"
                       class="btn btn-outline-secondary ms-1">
                        Edit Items
                    </a>

                    <a asp-action="Summary"
                       asp-route-id="@Model.OrderRequestId"
                       class="btn btn-outline-primary ms-1">
                        Summary
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        @if (!Model.Items.Any())
        {
            <div class="alert alert-warning">No items in this order.</div>
        }
        else
        {
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title mb-3">Items</h5>

                    <table class="table table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th class="text-end">Unit</th>
                                <th class="text-end">Qty</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@item.ProductName</td>
                                    <td class="text-end">@item.UnitPrice.ToString("0.00")</td>
                                    <td class="text-end">@item.Quantity</td>
                                    <td class="text-end">@item.RowTotal.ToString("0.00")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="3" class="text-end">Total</th>
                                <th class="text-end">@Model.TotalPrice.ToString("0.00")</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        }
    </div>
</div>
