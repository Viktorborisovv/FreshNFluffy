@model FreshNFluffy.ViewModels.Orders.Management.OrderDetailsViewModel

@{
    ViewData["Title"] = $"Order #{Model.OrderRequestId}";
}

<div class="ff-glass p-4 mb-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
        <h2 class="mb-0">Order #@Model.OrderRequestId</h2>

        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Manage" class="btn btn-secondary">Back to Manage</a>

            @if (Model.StatusValue != 3 && Model.StatusValue != 4)
            {
                <a asp-action="AddItems" asp-route-id="@Model.OrderRequestId" class="btn btn-outline-primary">
                    Edit Items
                </a>
            }

            <a asp-action="Summary" asp-route-id="@Model.OrderRequestId" class="btn btn-primary">
                Summary
            </a>
        </div>
    </div>

    <hr class="my-3" />

    <div class="row g-3">
        <div class="col-lg-6">
            <div class="p-3 rounded-3 bg-white bg-opacity-50">
                <div class="mb-2"><strong>Customer:</strong> @Model.CustomerName</div>
                <div class="mb-2"><strong>Phone:</strong> @Model.PhoneNumber</div>
                <div class="mb-2"><strong>Created:</strong> @Model.CreatedOn.ToString("dd.MM.yyyy HH:mm")</div>
                <div class="mb-2"><strong>Pickup:</strong> @Model.PickupDate.ToString("dd.MM.yyyy HH:mm")</div>

                <div class="mb-2">
                    <strong>Status:</strong>
                    @if (Model.StatusValue == 0)
                    {
                        <span class="ff-badge bg-secondary text-white">@Model.Status</span>
                    }
                    else if (Model.StatusValue == 1)
                    {

                        <span class="ff-badge bg-success text-white">@Model.Status</span>
                    }
                    else if (Model.StatusValue == 2)
                    {

                        <span class="ff-badge bg-warning text-dark">@Model.Status</span>
                    }
                    else if (Model.StatusValue == 3)
                    {

                        <span class="ff-badge bg-primary text-white">@Model.Status</span>
                    }
                    else if (Model.StatusValue == 4)
                    {

                        <span class="ff-badge bg-danger text-white">@Model.Status</span>
                    }
                    else
                    {

                        <span class="ff-badge bg-dark text-white">@Model.Status</span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div class="mt-3">
                        <strong>Notes:</strong>
                        <div class="text-muted">@Model.Notes</div>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-6">
            @if (Model.StatusValue == 0 || Model.StatusValue == 1 || Model.StatusValue == 2)
            {
                <div class="p-3 rounded-3 bg-white bg-opacity-50">
                    <div class="fw-semibold mb-2">Status actions</div>

                    @* Pending *@
                    @if (Model.StatusValue == 0)
                    {
                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="orderRequestId" value="@Model.OrderRequestId" />
                            <input type="hidden" name="newStatus" value="1" />
                            <button class="btn btn-sm btn-success" type="submit">Confirm</button>
                        </form>

                        <form asp-action="UpdateStatus" method="post" class="d-inline ms-1">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="orderRequestId" value="@Model.OrderRequestId" />
                            <input type="hidden" name="newStatus" value="4" />
                            <button class="btn btn-sm btn-danger" type="submit">Cancel</button>
                        </form>
                    }
                    @* Confirmed *@
                    else if (Model.StatusValue == 1)
                    {
                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="orderRequestId" value="@Model.OrderRequestId" />
                            <input type="hidden" name="newStatus" value="2" />
                            <button class="btn btn-sm btn-warning" type="submit">Mark Ready</button>
                        </form>

                        <form asp-action="UpdateStatus" method="post" class="d-inline ms-1">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="orderRequestId" value="@Model.OrderRequestId" />
                            <input type="hidden" name="newStatus" value="4" />
                            <button class="btn btn-sm btn-danger" type="submit">Cancel</button>
                        </form>
                    }
                    @* Ready *@
                    else if (Model.StatusValue == 2)
                    {
                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="orderRequestId" value="@Model.OrderRequestId" />
                            <input type="hidden" name="newStatus" value="3" />
                            <button class="btn btn-sm btn-primary" type="submit">Complete</button>
                        </form>

                        <form asp-action="UpdateStatus" method="post" class="d-inline ms-1">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="orderRequestId" value="@Model.OrderRequestId" />
                            <input type="hidden" name="newStatus" value="4" />
                            <button class="btn btn-sm btn-danger" type="submit">Cancel</button>
                        </form>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-secondary mb-0">
                    This order is locked (Completed/Cancelled).
                </div>
            }
        </div>
    </div>
</div>

@if (!Model.Items.Any())
{
    <div class="alert alert-warning">No items in this order.</div>
}
else
{
    <div class="ff-table-wrap">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Product</th>
                    <th class="text-end">Unit</th>
                    <th class="text-end">Qty</th>
                    <th class="text-end">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.ProductName</td>
                        <td class="text-end">@item.UnitPrice.ToString("0.00")</td>
                        <td class="text-end">@item.Quantity</td>
                        <td class="text-end">@item.RowTotal.ToString("0.00")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3" class="text-end">Total</th>
                    <th class="text-end">@Model.TotalPrice.ToString("0.00")</th>
                </tr>
            </tfoot>
        </table>
    </div>
}
