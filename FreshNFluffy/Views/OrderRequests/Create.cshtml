@model FreshNFluffy.ViewModels.Orders.OrderCreateViewModel

@{
    ViewData["Title"] = "Create Order Request";
}

<div class="ff-glass p-4">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <h2 class="mb-0">Order Request</h2>
    </div>

    <form asp-action="Create" method="post" class="ff-form">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="CustomerName" class="form-label fw-semibold"></label>
                <input asp-for="CustomerName" class="form-control ff-input" placeholder="e.g. Viktor Borisov" />
                <span asp-validation-for="CustomerName" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                <input asp-for="PhoneNumber" class="form-control ff-input" placeholder="+359..." inputmode="tel" />
                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="PickupDate" class="form-label fw-semibold"></label>
                <input asp-for="PickupDate" type="datetime-local" class="form-control ff-input" />
                <div class="form-text fw-bold">Choose a pickup date/time that works for you.</div>
                <span asp-validation-for="PickupDate" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="Notes" class="form-label fw-semibold"></label>
                <textarea asp-for="Notes" class="form-control ff-input" rows="3" placeholder="Optional: allergies, delivery notes, etc."></textarea>
                <span asp-validation-for="Notes" class="text-danger small"></span>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-4">
            <button type="submit" class="btn btn-primary">
                Continue to Products
            </button>

            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
