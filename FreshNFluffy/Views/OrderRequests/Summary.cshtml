@model FreshNFluffy.ViewModels.Orders.OrderSummaryViewModel

@{
    ViewData["Title"] = $"Order #{Model.OrderRequestId} - Summary";
}

<div class="ff-glass p-4 mb-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
        <h2 class="mb-0">Order #@Model.OrderRequestId — Summary</h2>

        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Manage" class="btn btn-primary">Edit Items</a>
            <a asp-action="AddItems" asp-route-id="@Model.OrderRequestId" class="btn btn-secondary">
                Back to Manage
            </a>
        </div>
    </div>

    <hr class="my-3" />

    <div class="row g-3">
        <div class="col-lg-7">
            <div class="p-3 rounded-3 bg-white bg-opacity-50">
                <div class="mb-2"><strong>Customer:</strong> @Model.CustomerName</div>
                <div class="mb-2"><strong>Phone:</strong> @Model.PhoneNumber</div>
                <div class="mb-2"><strong>Pickup:</strong> @Model.PickupDate.ToString("dd.MM.yyyy HH:mm")</div>

                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div class="mt-2">
                        <strong>Notes:</strong>
                        <div class="text-muted">@Model.Notes</div>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-5">
            <div class="p-3 rounded-3 bg-white bg-opacity-50 h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="fw-semibold mb-1">Total Price</div>
                    <div class="display-6 fw-bold">@Model.TotalPrice.ToString("0.00") <span class="fs-5">EUR</span></div>
                </div>

                <div class="mt-3 d-flex flex-wrap gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                        Done
                    </a>
                    <a asp-action="AddItems" asp-route-id="@Model.OrderRequestId" class="btn btn-secondary">
                        Back
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@if (!Model.Items.Any())
{
    <div class="alert alert-warning">No items in this order.</div>
}
else
{
    <div class="ff-table-wrap">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Product</th>
                    <th class="text-end">Unit Price</th>
                    <th class="text-end">Qty</th>
                    <th class="text-end">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.ProductName</td>
                        <td class="text-end">@item.UnitPrice.ToString("0.00")</td>
                        <td class="text-end">@item.Quantity</td>
                        <td class="text-end">@item.RowTotal.ToString("0.00")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3" class="text-end">Grand Total</th>
                    <th class="text-end">@Model.TotalPrice.ToString("0.00")</th>
                </tr>
            </tfoot>
        </table>
    </div>
}
