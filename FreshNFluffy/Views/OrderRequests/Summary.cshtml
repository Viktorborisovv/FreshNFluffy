@model FreshNFluffy.ViewModels.Orders.OrderSummaryViewModel

@{
    ViewData["Title"] = "Order Summary";
}

<h2 class="mb-3">Order Summary #@Model.OrderRequestId</h2>

<div class="card mb-3">
    <div class="card-body">
        <p class="mb-1"><strong>Customer:</strong> @Model.CustomerName</p>
        <p class="mb-1"><strong>Phone:</strong> @Model.PhoneNumber</p>
        <p class="mb-1"><strong>Pickup:</strong> @Model.PickupDate</p>
        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <p class="mb-0"><strong>Notes:</strong> @Model.Notes</p>
        }
    </div>
</div>

@if (!Model.Items.Any())
{
    <div class="alert alert-warning">No items in this order.</div>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Product</th>
                <th class="text-end">Unit Price</th>
                <th class="text-end">Qty</th>
                <th class="text-end">Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.ProductName</td>
                    <td class="text-end">@item.UnitPrice.ToString("0.00")</td>
                    <td class="text-end">@item.Quantity</td>
                    <td class="text-end">@item.RowTotal.ToString("0.00")</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-end">Total</th>
                <th class="text-end">@Model.TotalPrice.ToString("0.00")</th>
            </tr>
        </tfoot>
    </table>
}

<a asp-action="AddItems" asp-route-id="@Model.OrderRequestId" class="btn btn-secondary">Back</a>
<a asp-controller="Home" asp-action="Index" class="btn btn-primary ms-1">Done</a>
