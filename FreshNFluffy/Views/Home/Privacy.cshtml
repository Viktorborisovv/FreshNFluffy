@{
    ViewData["Title"] = "Privacy";
}

<div class="ff-surface p-4 p-md-5">
    <h2 class="fw-bold mb-2">Privacy Policy</h2>
    <p class="ff-muted mb-4">
        Demo project. We store only what’s needed to process an order request.
    </p>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="ff-card p-4 h-100">
                <div class="fw-semibold mb-2">What we store:</div>
                <ul class="ff-muted mb-0">
                    <li>Customer name and phone number</li>
                    <li>Pickup date/time</li>
                    <li>Order items (product and quantity)</li>
                    <li>Optional notes</li>
                </ul>
            </div>
        </div>

        <div class="col-md-6">
            <div class="ff-card p-4 h-100">
                <div class="fw-semibold mb-2">Why we store it:</div>
                <ul class="ff-muted mb-0">
                    <li>To prepare the order correctly</li>
                    <li>To contact you if needed</li>
                    <li>To manage order status</li>
                </ul>
            </div>
        </div>
    </div>
</div>
