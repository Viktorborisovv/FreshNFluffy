@{
    ViewData["Title"] = "Home";
}

<div class="ff-hero mb-4">
    <div class="row align-items-center g-4">
        <div class="col-lg-8">
            <div class="ff-pill mb-3">
                <span>✨</span>
                <span class="small fw-semibold">Fresh desserts • Made daily</span>
            </div>

            <h1 class="display-5 fw-bold mb-2">FreshNFluffy Bakery</h1>
            <p class="lead ff-muted mb-4">
                Browse products, create an order request, and pick it up at your preferred time.
            </p>

            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Products" asp-action="Index" class="btn btn-outline-primary btn-lg">
                    Browse Products
                </a>
                <a asp-controller="OrderRequests" asp-action="Create" class="btn btn-outline-primary btn-lg">
                    Make an Order
                </a>
                <a asp-controller="OrderRequests" asp-action="Manage" class="btn btn-outline-primary btn-lg">
                    Manage Orders
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 row-cols-1 row-cols-md-2 row-cols-lg-4">
    <div class="col">
        <div class="ff-feature ff-feature-blue p-4 h-100">
            <div class="ff-feature-title">🍞 Fresh Daily</div>
            <div class="ff-feature-text">We bake every day so you get the best taste and quality.</div>
        </div>
    </div>

    <div class="col">
        <div class="ff-feature ff-feature-purple p-4 h-100">
            <div class="ff-feature-title">🧾 Order Request</div>
            <div class="ff-feature-text">Create a request, add items, and confirm pickup details.</div>
        </div>
    </div>

    <div class="col">
        <div class="ff-feature ff-feature-green p-4 h-100">
            <div class="ff-feature-title">🥗 Nutrition Types</div>
            <div class="ff-feature-text">Gluten-free, vegan, keto, sugar-free and more.</div>
        </div>
    </div>

    <div class="col">
        <div class="ff-feature ff-feature-amber p-4 h-100">
            <div class="ff-feature-title">🕒 Pick a Time</div>
            <div class="ff-feature-text">Choose pickup date/time that works for you.</div>
        </div>
    </div>
</div>


