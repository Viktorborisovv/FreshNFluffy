@model ErrorViewModel
@{
    ViewData["Title"] = "Server Error";
}

<div class="ff-glass p-5 text-center">
    <h1 class="display-5 fw-bold text-danger mb-3">500</h1>
    <h2 class="mb-3">Something went wrong</h2>
    <p class="text-muted mb-4">
        An unexpected error occurred while processing your request.
    </p>

    @if (Model.ShowRequestId)
    {
        <p class="mb-4">
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }

    <div class="d-flex justify-content-center gap-3 flex-wrap">
        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary">
            Back to Home
        </a>

        <a asp-area="" asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary">
            Browse Products
        </a>
    </div>
</div>